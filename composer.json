{
    "name": "winpay/core",
    "version": "1.0.0",
    "description": "Winpay Core - Framework agnostic payment gateway library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Winpay",
            "homepage": "https://github.com/winpay"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required if not providing a PSR-18 client manually"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1",
        "php-http/mock-factory": "^1.0",
        "guzzlehttp/psr7": "^2.0",
        "guzzlehttp/guzzle": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Winpay\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Winpay\\Core\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
